{
  "name": "@release-it/bumper",
  "version": "8.0.0",
  "description": "Version read/write plugin for release-it",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "release": "release-it"
  },
  "keywords": [
    "release",
    "release-it",
    "release-it-plugin",
    "version",
    "bump",
    "increment",
    "manifest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/release-it/bumper.git"
  },
  "homepage": "https://github.com/release-it/bumper#readme",
  "bugs": {
    "url": "https://github.com/release-it/bumper/issues"
  },
  "author": "Lars Kappert <lars@webpro.nl>",
  "dependencies": {
    "@decimalturn/toml-patch": "^3.1.0",
    "@iarna/toml": "^3.0.0",
    "cheerio": "^1.2.0",
    "detect-indent": "7.0.2",
    "fast-glob": "^3.3.3",
    "ini": "^7.0.0",
    "js-yaml": "^5.4.2",
    "lodash-es": "^4.18.1",
    "verkit": "^0.4.0"
  },
  "devDependencies": {
    "installed-check": "^11.0.0",
    "release-it": "^21.0.3",
    "sinon": "^22.1.0"
  },
  "peerDependencies": {
    "release-it": "^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "release-it": {
    "hooks": {
      "before:init": "pnpm test && installed-check --no-workspaces"
    },
    "npm": {
      "stage": true
    },
    "github": {
      "tokenRef": "GITHUB_TOKEN_RELEASE_IT",
      "release": true,
      "releaseNotes": {
        "commit": "* ${commit.subject} (${sha}){ - thanks @${author.login}!}",
        "excludeMatches": [
          "webpro"
        ]
      },
      "comments": {
        "submit": true
      }
    }
  },
  "main": "index.js"
}
